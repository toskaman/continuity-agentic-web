{
  "name": "continuity-open-agentic-web",
  "version": "1.0.0",
  "description": "CONTINUITY \u2014 Safe Multi-Provider Change Coordinator for the Open Agentic Web (Cognizant Open Agentic Web Challenge)",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:networks": "node scripts/build_all_networks.mjs",
    "check:networks": "node scripts/build_all_networks.mjs --check",
    "check:partners": "node scripts/verify_live_ecosystem.mjs",
    "serve:all": "node scripts/serve_ecosystem.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:contracts": "node --test \"tests/contracts/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:security": "node --test \"tests/security/*.test.mjs\"",
    "test:chaos": "node --test \"tests/chaos/*.test.mjs\"",
    "test:sites": "node --test \"apps/*/tests/*.test.mjs\"",
    "test": "node scripts/run_all_tests.mjs",
    "benchmark": "node scripts/run_benchmarks.mjs",
    "audit:perf": "node scripts/audit_browser_perf.mjs",
    "audit:submission": "node packages/nanda-resolver/cli.mjs",
    "verify:live-llm": "node scripts/verify_live_llm.mjs"
  }
}
